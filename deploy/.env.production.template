# ============================================================================
# NexCRM production environment template
#
# Copy to .env.production and fill in. NEVER commit the filled version.
# In production, prefer a secrets manager (AWS Secrets Manager / GCP Secret
# Manager) over a file — the app reads plain env vars, so either works.
#
# The API refuses to start in production if JWT_SECRET / HOST_JWT_SECRET are
# still the dev defaults, CREDENTIALS_KEY is missing, or APP_URL isn't https
# (see assertProductionConfig in apps/api/src/config.ts). That's deliberate:
# a deploy with dev secrets is a serious risk and should fail loudly.
# ============================================================================

NODE_ENV=production
PORT=4000

# ---- Database ----
# The app connects as crm_app (RLS enforced, NOBYPASSRLS). Migrations use the
# admin URL. Keep these as two distinct roles — running the app as the owner
# would defeat row-level security.
DATABASE_URL=postgres://crm_app:CHANGE_ME@db-host:5432/nexcrm
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@db-host:5432/nexcrm
DB_MODE=external

# ---- Secrets: generate each with `openssl rand -base64 32` ----
JWT_SECRET=
HOST_JWT_SECRET=
# AES-256-GCM key protecting tenant-supplied third-party credentials
# (Gupshup/Twilio/SendGrid/payment keys). Losing this makes stored connector
# credentials unrecoverable by design — customers would re-enter them.
# Rotating it requires re-encrypting existing rows.
CREDENTIALS_KEY=

# ---- URLs ----
# Used to build one-time set-password links. Must be https in production.
APP_URL=https://app.yourcrm.com

# ---- API limits (defaults; per-tenant overrides live in the DB) ----
API_BURST_SECONDS=5
API_RATE_PER_WINDOW=250
API_DAILY_QUOTA=50000

# ---- Inbound connector verify tokens (set these to random strings) ----
META_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- Migrations ----
MIGRATIONS_DIR=/db/migrations

# ---- Frontend build-time (Vite inlines this at BUILD time, not runtime) ----
VITE_API_URL=https://api.yourcrm.com
